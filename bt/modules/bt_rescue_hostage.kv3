				{ type = "action_use" },
				{ type = "action_use" },
				{ type = "action_use" },
				// action_choose_team_spawn_area is the *enemy* spawn (hunt target), so pick
				// CT spawn points directly; the rescue zone is there on cs_office.
				{
					type = "decorator_sensor"
					entity_type_filter = "CLASSNAME"
					output = "RescueAreas"
					class_name = "info_player_counterterrorist"
				},
				{
					type = "action_choose_random_waypoint"
					input = "RescueAreas"
					output = "RescuePoint"
				},
				{
					type = "action_move_to"
					destination = "RescuePoint"
					movement_type = "BT_ACTION_MOVETO_RUN"
					route_type = "BT_ACTION_MOVETO_SAFEST_ROUTE"
				}
			]
		}
	}
}
